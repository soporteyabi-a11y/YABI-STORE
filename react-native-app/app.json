{
  "expo": {
    "name": "YA'BI Store",
    "slug": "yabi-store",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Permite escanear códigos de barras y QR en el POS e Inventario de YA'BI Store."
        }
      ],
      "expo-sqlite"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "co.yabistore.app"
    },
    "android": {
      "package": "co.yabistore.app",
      "permissions": ["CAMERA"]
    }
  }
}
